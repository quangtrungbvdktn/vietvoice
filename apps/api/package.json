{
  "name": "@vietvoice/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/server.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vietvoice/agent-protocol": "workspace:*",
    "@vietvoice/contracts": "workspace:*",
    "@vietvoice/database": "workspace:*",
    "@vietvoice/pipeline-core": "workspace:*",
    "@vietvoice/provider-adapters": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
